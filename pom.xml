<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.microservice</groupId>
    <artifactId>microservice-product</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <spring.version>5.3.20</spring.version>
        <hibernate.version>5.6.9.Final</hibernate.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Spring Context : conteneur IoC, @Configuration, @ComponentScan... -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <!-- Spring ORM : intégration Hibernate (LocalSessionFactoryBean, HibernateTransactionManager) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <!-- Hibernate Core : implémentation JPA (apporte aussi les annotations javax.persistence) -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <!-- Pilote MySQL : gardé pour pouvoir repasser sur MySQL (voir application.properties) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
        </dependency>

        <!-- Base H2 : base utilisée par l'application (fichier ./data) et par les tests (en mémoire).
             Scope compile car H2Console utilise aussi org.h2.tools.Server -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Pendant "mvn test", ces propriétés système remplacent celles d'application.properties :
                 les tests tournent sur une base H2 en mémoire, vidée à chaque test,
                 et ne touchent jamais aux données de l'application (./data) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <jdbc.driver>org.h2.Driver</jdbc.driver>
                        <jdbc.url>jdbc:h2:mem:product_test;DB_CLOSE_DELAY=-1</jdbc.url>
                        <jdbc.username>sa</jdbc.username>
                        <jdbc.password></jdbc.password>
                        <hibernate.dialect>org.hibernate.dialect.H2Dialect</hibernate.dialect>
                        <hibernate.show_sql>false</hibernate.show_sql>
                        <hibernate.hbm2ddl.auto>create-drop</hibernate.hbm2ddl.auto>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
